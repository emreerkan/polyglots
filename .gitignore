node_modules
dist
*.log
.env

# Editor scratch files. One of these was committed by accident in 55811a9.
.*.sw[a-p]
*~

# Copied in by app/scripts/prepack.mjs at publish time; the originals live at the root.
app/README.md
app/LICENSE

# Agent worktrees.
.claude/worktrees/

# Antigravity's CLI writes a per-folder workspace file here when agy runs in
# the repo. It holds the absolute path of the checkout, and nothing the
# project needs.
.antigravitycli/

# macOS folder metadata.
.DS_Store

# polyglots' own databases. The real ones live under ~/.local/share/polyglots;
# one appearing in the tree means something ran with POLYGLOTS_HOME pointed
# here by mistake, which happened once, and it must not be committed.
*.db
*.db-wal
*.db-shm

# The maintainer's own working notes for agents, imported by CLAUDE.md.
CLAUDE.local.md

# Internal design notes; kept locally, not part of the project.
notes/

# Brainstorming mockups from the visual companion; local only.
.superpowers/
