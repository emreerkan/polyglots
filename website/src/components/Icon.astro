---
interface Props {
  name: 'copy' | 'check' | 'sun' | 'moon' | 'auto' | 'github' | 'replay' | 'pause' | 'arrow' | 'download' | 'x' | 'expand';
  class?: string;
}
const { name, class: className } = Astro.props;
---
<svg class:list={['icon', className]} width="18" height="18" aria-hidden="true" focusable="false"><use href={`#i-${name}`} /></svg>
