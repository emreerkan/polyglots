---
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<footer class="site">
  <div class="wrap cols">
    <p>
      polyglots is made by <a href="https://ada.agency/">Ada Digital Agency</a> and released under the MIT licence.
    </p>
    <ul>
      <li><a href={`${base}docs/`}>Docs</a></li>
      <li><a href={`${base}ai/`}>For agents</a></li>
      <li><a href="https://github.com/emreerkan/polyglots">GitHub</a></li>
      <li><a href="https://www.npmjs.com/package/polyglots">npm</a></li>
      <li><a href="https://github.com/sponsors/emreerkan">Sponsor on GitHub</a></li>
      <li><a href="https://buymeacoffee.com/emree">Buy me a coffee</a></li>
    </ul>
    <p class="fine muted">
      Not affiliated with or endorsed by WordPress.org or the WordPress Foundation.
      WordPress is a trademark of the WordPress Foundation.
    </p>
  </div>
</footer>

<style>
  .site { border-top: 1px solid var(--rule); margin-top: 5rem; padding: 2.5rem 0 3rem; font-size: 0.95rem; color: var(--fg-2); }
  .cols { display: grid; gap: 1rem; }
  ul { list-style: none; display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; margin: 0; padding: 0; }
  .fine { font-size: 0.85rem; margin: 0; }
</style>
