{
  "name": "polyglots",
  "version": "0.27.0",
  "description": "Translate and review WordPress .po files with machine drafts and AI review",
  "keywords": [
    "wordpress",
    "gettext",
    "po",
    "pot",
    "translation",
    "i18n",
    "l10n",
    "glotpress",
    "translate.wordpress.org",
    "cli",
    "tui"
  ],
  "homepage": "https://ada.tools/polyglots/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emreerkan/polyglots.git",
    "directory": "app"
  },
  "bugs": {
    "url": "https://github.com/emreerkan/polyglots/issues"
  },
  "type": "module",
  "bin": {
    "polyglots": "./dist/cli.js"
  },
  "files": [
    "dist/",
    "i18n/",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc",
    "typecheck": "tsc -p tsconfig.test.json && tsc -p tsconfig.client.json",
    "test": "vitest run",
    "dev": "tsx src/cli.ts",
    "prepare": "npm run build",
    "prebuild": "node scripts/no-live-run.mjs && node scripts/stats-i18n.mjs && node scripts/stats-client.mjs",
    "update-locales": "node scripts/update-locales.mjs",
    "stats-pot": "tsx scripts/stats-pot.ts",
    "stats-i18n": "node scripts/stats-i18n.mjs",
    "stats-client": "node scripts/stats-client.mjs",
    "release": "node scripts/release.mjs",
    "prepack": "node scripts/prepack.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "better-sqlite3": "^13.0.3",
    "cheerio": "^1.2.0",
    "commander": "^15.0.0",
    "deepl-node": "^1.28.0",
    "dotenv": "^17.4.2",
    "fast-xml-parser": "^5.11.1",
    "gettext-parser": "^9.1.1",
    "ink": "^7.1.1",
    "ink-select-input": "^6.2.0",
    "ink-text-input": "^6.0.0",
    "openai": "^7.10.0",
    "react": "^19.2.8",
    "slice-ansi": "^9.0.0",
    "string-width": "^8.2.2",
    "yaml": "^2.9.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/gettext-parser": "^9.0.0",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.14.5",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
